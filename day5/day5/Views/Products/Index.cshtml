@model IEnumerable<day5.Models.Product>

<h2>Danh sách sản phẩm</h2>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-action="Create" class="btn btn-primary">Thêm sản phẩm mới</a>
    </div>

    <!-- Form Tìm kiếm -->
    <div class="col-md-6">
        <form asp-action="Index" method="get" class="d-flex justify-content-end">
            <input type="text" name="searchString" value="@ViewBag.CurrentFilter"
                   class="form-control me-2" placeholder="Nhập tên hoặc mô tả sản phẩm..." />
            <button type="submit" class="btn btn-outline-primary me-1">Tìm</button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            }
        </form>
    </div>
</div>

<!-- Bảng hiển thị dữ liệu -->
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.Stock)</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Không tìm thấy sản phẩm nào.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("N0") VNĐ</td>
                    <td>@item.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Thanh Phân trang -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <!-- Nút Trang trước -->
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchString="@ViewBag.CurrentFilter">Trước</a>
            </li>

            <!-- Các số trang -->
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.CurrentFilter">@i</a>
                </li>
            }

            <!-- Nút Trang sau -->
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchString="@ViewBag.CurrentFilter">Sau</a>
            </li>
        </ul>
    </nav>
}