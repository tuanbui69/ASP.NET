@model Day2_BuiDinhTuan.Models.ServerStats

@*
    VIEWCOMPONENT: QuickStats Default.cshtml
    Thiết kế tối giản: Giao diện đen - xám - trắng, không màu mè, tinh gọn.
*@

<div class="card h-100 border">
    <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-dark">@Model.ComponentTitle</span>
        <span class="badge bg-light text-dark border fw-normal">ViewComponent</span>
    </div>
    <div class="card-body p-3">
        <ul class="list-unstyled mb-0 small">
            <li class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Cập nhật lúc:</span>
                <span class="text-dark font-monospace">@Model.GeneratedTime.ToString("HH:mm:ss")</span>
            </li>
            <li class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">Người dùng trực tuyến:</span>
                <span class="fw-semibold text-dark">@Model.ActiveUsers</span>
            </li>
            <li class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted">RAM chiếm dụng:</span>
                <span class="text-dark font-monospace">@Model.MemoryUsageMB MB</span>
            </li>
            <li class="d-flex justify-content-between py-1">
                <span class="text-muted">Tổng bài viết:</span>
                <span class="fw-semibold text-dark">@Model.TotalArticles</span>
            </li>
        </ul>
    </div>
    <div class="card-footer bg-white border-top py-2 text-muted small">
        Tự xử lý qua <code>QuickStatsViewComponent.cs</code>
    </div>
</div>
