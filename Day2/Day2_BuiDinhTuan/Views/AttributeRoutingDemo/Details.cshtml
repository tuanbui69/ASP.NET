@model Day2_BuiDinhTuan.Controllers.AttributeRoutingDemoController.Course

@{
    ViewData["Title"] = "Chi tiết khóa học";
}

<div class="container my-4">
    <div class="card border">
        <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">@Model.Title</span>
            <span class="badge bg-light text-dark border fw-normal">Attribute Route</span>
        </div>
        <div class="card-body p-3">
            <!-- THÔNG TIN ROUTING TỐI GIẢN -->
            <div class="p-2 mb-3 bg-light rounded border text-muted small">
                <div class="fw-semibold text-dark mb-1">Thông số Route nhận được:</div>
                <div class="row g-2">
                    <div class="col-sm-6">URL: <code>@Context.Request.Path</code></div>
                    <div class="col-sm-6">Template: <code>[HttpGet("khoa-hoc/{id:int}/{slug?}")]</code></div>
                    <div class="col-sm-6">Tham số ID: <strong class="text-dark">@Model.Id</strong> (ràng buộc <code>:int</code>)</div>
                    <div class="col-sm-6">Tham số Slug: <strong class="text-dark">@ViewData["PassedSlug"]</strong></div>
                </div>
            </div>

            <!-- NỘI DUNG CHI TIẾT -->
            <div class="row g-3">
                <div class="col-md-8">
                    <h6 class="fw-semibold text-dark">Nội dung tóm tắt:</h6>
                    <p class="text-secondary small">@Model.Description</p>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-secondary small">
                        <div>Mã môn: <strong class="text-dark">KH-@Model.Id</strong></div>
                        <div>Số tín chỉ: <strong class="text-dark">@Model.Credits</strong></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white border-top py-2 d-flex justify-content-between align-items-center">
            <a href="/dinh-tuyen-thuoc-tinh" class="btn btn-sm btn-outline-secondary">
                &larr; Quay lại danh sách
            </a>
            <span class="text-muted small">Attribute Routing Demo</span>
        </div>
    </div>
</div>
