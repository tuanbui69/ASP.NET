@model IEnumerable<Day2_BuiDinhTuan.Controllers.AttributeRoutingDemoController.Course>

@{
    ViewData["Title"] = "Conventional vs Attribute Routing";
}

<div class="container my-4">
    <!-- TIÊU ĐỀ TỐI GIẢN -->
    <div class="border-bottom pb-2 mb-4">
        <h4 class="fw-bold text-dark mb-1">Conventional Routing vs Attribute Routing</h4>
        <p class="text-secondary small mb-0">So sánh định tuyến quy ước tập trung trong Program.cs và định tuyến thuộc tính trên Controller/Action.</p>
    </div>

    <!-- KHỐI SO SÁNH 2 LOẠI ROUTING -->
    <div class="row g-4 mb-4">
        
        <!-- 1. CONVENTIONAL ROUTING -->
        <div class="col-lg-6">
            <div class="card h-100 border">
                <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-dark">1. Conventional Routing</span>
                    <span class="text-muted small">Quy ước tập trung</span>
                </div>
                <div class="card-body p-3">
                    <p class="text-secondary small mb-3">
                        Định nghĩa trong <code>Program.cs</code> với pattern: <code>{controller=Home}/{action=Index}/{id?}</code>.
                    </p>

                    <div class="list-group mb-3 small">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Mặc định:</span>
                            <a href="/Hello" class="btn btn-sm btn-outline-secondary py-0">/Hello</a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Query string:</span>
                            <a href="/Hello/Welcome?name=Tuan&ID=3" class="btn btn-sm btn-outline-secondary py-0">/Hello/Welcome?name=Tuan&ID=3</a>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Quy ước tùy biến:</span>
                            <a href="/chao-mung/BuiDinhTuan/5" class="btn btn-sm btn-outline-secondary py-0">/chao-mung/BuiDinhTuan/5</a>
                        </div>
                    </div>

                    <p class="text-muted small mb-0">
                        Thích hợp cho ứng dụng web đồng bộ, quản lý toàn bộ URL từ một nơi duy nhất.
                    </p>
                </div>
            </div>
        </div>

        <!-- 2. ATTRIBUTE ROUTING -->
        <div class="col-lg-6">
            <div class="card h-100 border">
                <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-dark">2. Attribute Routing</span>
                    <span class="text-muted small">Thuộc tính trực tiếp</span>
                </div>
                <div class="card-body p-3">
                    <p class="text-secondary small mb-3">
                        Khai báo trực tiếp qua <code>[Route("...")]</code> và <code>[HttpGet("khoa-hoc/{id:int}/{slug?}")]</code>.
                    </p>

                    <div class="list-group mb-3 small">
                        @foreach (var c in Model)
                        {
                            <a href="/dinh-tuyen-thuoc-tinh/khoa-hoc/@c.Id/@c.Slug" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold text-dark">@c.Title</div>
                                    <span class="text-muted small">Mã: @c.Id | @c.Credits tín chỉ</span>
                                </div>
                                <span class="badge bg-light text-dark border">Chi tiết</span>
                            </a>
                        }
                    </div>

                    <p class="text-muted small mb-0">
                        Hỗ trợ ràng buộc kiểu (<code>:int</code>), tối ưu SEO và là chuẩn cho RESTful Web API.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG ĐỐI CHIẾU TỐI GIẢN -->
    <div class="card border">
        <div class="card-header bg-white border-bottom py-2">
            <span class="fw-semibold text-dark">Bảng so sánh cơ chế định tuyến</span>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%">Đặc tính</th>
                        <th style="width: 40%">Conventional Routing</th>
                        <th style="width: 40%">Attribute Routing</th>
                    </tr>
                </thead>
                <tbody class="small">
                    <tr>
                        <td class="fw-semibold">Nơi khai báo</td>
                        <td>Tập trung trong file <code>Program.cs</code>.</td>
                        <td>Trực tiếp trên class Controller và Action method.</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Cú pháp</td>
                        <td><code>app.MapControllerRoute(...)</code></td>
                        <td><code>[Route(...)], [HttpGet(...)], [HttpPost(...)]</code></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Ràng buộc kiểu (Constraint)</td>
                        <td>Cấu hình trong chuỗi pattern toàn cục.</td>
                        <td>Trực quan và dễ đọc: <code>{id:int}</code>, <code>{slug?}</code>.</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Mục đích chính</td>
                        <td>Web MVC truyền thống, giao diện có cấu trúc đồng bộ.</td>
                        <td>Web API RESTful, trang thương mại / tin tức cần URL chuẩn SEO.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
